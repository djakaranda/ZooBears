{"call_id": "u101_00068:call0000", "facts": [{"object": {"id": "u101_00068:ticket:039416c4", "type": "ticket", "name": "заявка 5160"}, "attribute": "ticket_status", "value": "принята", "polarity": 1, "speaker": "operator", "valid_from": "2026-03-31T00:00:00", "valid_to": "2026-04-04T00:00:00", "source": {"turn_idx": 8, "span": [62, 69], "quote": "принята"}}, {"object": {"id": "u101_00068:client:3e2bb033", "type": "client", "name": "Марин Олеговна"}, "attribute": "agreement", "value": "подтверждение заявки по смс", "polarity": 1, "speaker": "operator", "valid_from": "2026-04-11T00:00:00", "valid_to": null, "source": {"turn_idx": 10, "span": [102, 129], "quote": "подтверждение заявки по смс"}}, {"object": {"id": "u101_00068:client:3e2bb033", "type": "client", "name": "Марин Олеговна"}, "attribute": "agreement", "value": "перенастройка назначена на субботу", "polarity": 1, "speaker": "client", "valid_from": "2026-04-06T16:00:00", "valid_to": null, "source": {"turn_idx": 11, "span": [0, 41], "quote": "в супботу да потходит я как раз дома буду"}}, {"object": {"id": "u101_00068:ticket:039416c4", "type": "ticket", "name": "заявка 5160"}, "attribute": "ticket_status", "value": "назначен выезд специалиста", "polarity": 1, "speaker": "operator", "valid_from": "2026-04-04T00:00:00", "valid_to": null, "source": {"turn_idx": 16, "span": [39, 65], "quote": "назначен выезд специалиста"}}]}
